# Supabase project settings.
# Leave empty to run Wingman in local demo mode (reminders stored in the browser).

# Project URL: Project Settings -> Data API (or the "Connect" button), e.g. https://abcd1234.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Project Settings -> API Keys -> "Secret keys" (starts with sb_secret_).
# Server-side only. Never expose it with a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=sb_secret_...

# Older projects: the legacy service_role key also works instead
# (Project Settings -> API Keys -> "Legacy API Keys" tab).
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
